{
	"name": "@antonii22/scribe2",
	"version": "0.0.25",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"build:wc": "vite build -c vite.wc.config.ts && tsc -p tsconfig.types.json && node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('src/lib/styles/scribe.css', 'dist/scribe.css'); fs.cpSync('src/lib/svelte', 'dist/svelte', { recursive: true, filter: (s) => !s.includes('.test.') })\" && node scripts/verify-core.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"verify:core": "node scripts/verify-core.mjs",
		"prepack": "npm run build:wc",
		"prepublishOnly": "npm test && npm run check && eslint src/lib src/routes scripts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/scribe.js"
	],
	"main": "./dist/scribe.js",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/docbusters/scribe2.git"
	},
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/scribe.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./scribe.css": "./dist/scribe.css",
		"./svelte": {
			"types": "./dist/svelte/mount.svelte.d.ts",
			"svelte": "./dist/svelte/mount.svelte.js",
			"default": "./dist/svelte/mount.svelte.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/sortablejs": "^1.15.9",
		"bits-ui": "^2.18.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"katex": "^0.18.5",
		"layerchart": "^2.3.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.21",
		"qr-code-styling": "^1.9.2",
		"sortablejs": "^1.15.7",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-maplibre-gl": "^2.2.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"uuid": "^14.0.2",
		"vite": "^8.0.16",
		"vitest": "^5.1.0"
	},
	"keywords": [
		"svelte"
	]
}
